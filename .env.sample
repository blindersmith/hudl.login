# Hudl test account — standard user (not admin)
# Used for all login tests via USERS.base_user
HUDL_EMAIL=
HUDL_PASSWORD=

# Admin account — leave blank if not available; falls back to HUDL_EMAIL/HUDL_PASSWORD
HUDL_ADMIN_EMAIL=
HUDL_ADMIN_PASSWORD=

# Target environment: production | staging
# Login tests currently point to production (https://www.hudl.com)
HUDL_ENV=production
